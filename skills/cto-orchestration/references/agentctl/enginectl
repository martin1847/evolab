#!/usr/bin/env bash
#   ln -sf <abs>/enginectl ~/.local/bin/codexctl
#   ln -sf <abs>/enginectl ~/.local/bin/claudectl
set -uo pipefail

INVOKED="$(basename "$0")"
SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
AGENTCTL="$(cd "$(dirname "$SELF")" && pwd)/agentctl"

ENG="${INVOKED%ctl}"
case "$ENG" in
  codex|claude|omp) ;;
  *) printf 'ERR: enginectl runs as codexctl, claudectl or ompctl (invoked as %s)\n  ln -sf <abs>/enginectl ~/.local/bin/codexctl\n  ln -sf <abs>/enginectl ~/.local/bin/claudectl\n' "$INVOKED" >&2; exit 1 ;;
esac

VERB="${1:-}"
[ "$#" -gt 0 ] && shift
case "$VERB" in
  start) exec "$AGENTCTL" start "$ENG" "$@" ;;
  steer|settings)
    thread=0; engine=0
    for a in "$@"; do
      case "$a" in
        --thread|--thread=*) thread=1 ;;
        --engine|--engine=*) engine=1 ;;
      esac
    done
    if [ "$thread" = 1 ] && [ "$engine" = 0 ]; then
      exec "$AGENTCTL" "$VERB" "$@" --engine "$ENG"
    fi
    exec "$AGENTCTL" "$VERB" "$@" ;;
  "") exec "$AGENTCTL" ;;
  *) exec "$AGENTCTL" "$VERB" "$@" ;;
esac
