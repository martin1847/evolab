#!/usr/bin/env bash
# agentctl — unified control surface for headless worker agents (duplex-lane era).
#
#   agentctl start  <omp|codex|claude> <session> <cwd> --goal F [--deliverable G]
#                   [--no-preflight] [engine args...]
#   agentctl steer  <session> (-m TEXT | -f FILE) [--now | --replace] [-d|--deliverable G]
#   agentctl status <session>            # one-shot typed state (exit = verdict)
#   agentctl watch  <session>            # block until terminal; typed exits (vocabulary below)
#   agentctl stop   <session> [cwd]      # end + clean control state (events kept for post-mortem)
#   agentctl capabilities [--json]       # runtime-generated provider capability contract
#
# ONE lane, three engines (unified 2026-07-19 after a live spike): every engine runs its
# native duplex stdio protocol long-lived inside a tmux supervisor pane — omp --mode=rpc,
# claude stream-json, codex app-server (JSON-RPC; experimental upstream, error frames
# self-describe drift). Steering is a protocol frame written to the session fifo
# (duplexctl.py = single flock-serialized writer). Capability gaps REFUSE cleanly instead
# of forking lanes, and the ONE capability table in duplexctl.py is what both the routing
# and `agentctl capabilities` read — the refusal an operator sees is the published note.
# tmux is a process SUPERVISOR only: the worker survives orchestrator restarts; nothing
# ever reads or types into the pane. NOT a transaction system (same stance as the round
# lane's pid lock): CONCURRENT same-name starts across lanes are an orchestrator-discipline
# bug — sequential collisions and duplex↔duplex races are refused mechanically (lane check
# + mkfifo claim); a cross-lane photo-finish is recovered by `agentctl stop`, not machinery. Typed exit vocabulary shared with the round lane:
#   0 DONE / 1 SESSION-GONE / 2 FAILED|AGENT-DEAD / 3 send-unconfirmed / 4 WAITING-INPUT
#   / 5 STALLED-EXTERNAL / 6 IDLE-NO-DELIVERABLE / 7 WATCH-TIMEOUT / 8 ENGINE-SILENT
#   / 9 BUDGET-EXHAUSTED / 11 STALLED-STREAM (stagnant stream + no tool child — salvage, then stop)
set -uo pipefail
# $0 may be a PATH symlink (~/.local/bin convenience installs) — follow the link chain
# before dirname, else CTL resolves beside the symlink and every engine name goes unknown.
SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
DIR="${AGENT_WATCH_DIR:-/tmp/agent-watch-run}"
CTL="$HERE/duplexctl.py"
PY="${AGENTCTL_PYTHON:-python3}"
ARMED_ID=""   # arm-time snapshot of the active identity; set by status/watch before classify
q() { printf %q "$1"; }
meta_get() { sed -n "s/^$2=//p" "$DIR/$1.duplex.meta" 2>/dev/null | head -1; }
usage() {
  echo "usage: agentctl start <omp|codex|claude> <session> <cwd> --goal F [--deliverable G] [--no-preflight] [engine args...]" >&2
  echo "       agentctl steer <session> (-m TEXT | -f FILE) [--now | --replace] [-d G]" >&2
  echo "       agentctl status <session> | watch <session> | stop <session> [cwd] | capabilities [--json]" >&2
  exit 1
}

# duplex sessions have .duplex.meta (the only lane since 2026-07-19 unification).
lane_of() { # $1 session
  if [ -f "$DIR/$1.duplex.meta" ]; then echo duplex; else echo none; fi
}

# A live `agentctl watch` publishes its own pid; a stale file (watcher crashed or was
# killed with the orchestrator's shell) reads as ABSENT — over-reminding is cheap,
# a RUNNING session nobody watches is not.
watcher_alive() { # $1 session
  local pid
  pid="$(cat "$DIR/$1.duplex.watch.pid" 2>/dev/null)" || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Arming a new watcher or stopping the session resolves any prior death: rotate the
# tombstone into .consumed (forensics kept) so status never re-reports a death across
# re-arms, restarts of the same name, or long-dead history (cold-review F-01).
consume_tombstone() { # $1 session
  local t="$DIR/$1.watch.tombstone.jsonl"
  [ -f "$t" ] || return 0
  # && — a failed append must NOT destroy the forensics (review F4); an unconsumed
  # tombstone re-reports at worst, a deleted one is gone for good.
  cat "$t" >> "$t.consumed" 2>/dev/null && rm -f "$t"
}

# tmux kill-session only signals the pane leader: engine children that outlive it (LSP
# servers, browsers, linters) get adopted by PID 1 and leak — field evidence 2026-07-28:
# 43 leaked sessions left 8 adopted workers + 16 grandchildren after a naive stop. The
# pane is spawned as its own session+group leader (pane_pid == pgid, probed on macOS),
# and POSIX keeps a pgid reserved while ANY member lives — so the process group is the
# ownership boundary: TERM the group, bounded grace, KILL, verify zero residue. Scope is
# always one pgid we own — never a name-based or global kill.
reap_tree() { # $1 pane_pid (== pgid)  $2 expected leader lstart ("" = pid read live, skip check)
  local pg="$1" want="$2" have i tries
  case "$pg" in ''|*[!0-9]*) return 0;; esac
  # lower bounds are load-bearing: on Linux procps `pgrep -g 0` is OUR OWN group
  # (macOS returns empty), and reaping our own pgid is suicide on any platform.
  [ "$pg" -gt 1 ] || return 0
  [ "$pg" = "$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')" ] && return 0
  pgrep -g "$pg" >/dev/null 2>&1 || return 0
  if [ -n "$want" ]; then
    # stale-meta path: this pgid is a stranger's only if the LEADER pid was recycled
    # after our whole tree died, so the leader's start time is the ownership fingerprint.
    # A dead leader with live members needs no check — the pgid stays ours while they live.
    have="$(ps -p "$pg" -o lstart= 2>/dev/null | sed 's/ *$//')"
    if [ -n "$have" ] && [ "$have" != "$want" ]; then
      echo "WARN: pgid $pg leader started '$have' ≠ recorded '$want' (pid recycled) — not ours, not reaping" >&2
      return 0
    fi
  fi
  kill -TERM -- "-$pg" 2>/dev/null
  # non-numeric falls back to the 5s default; an explicit 0 means NO grace (straight
  # to KILL) — that's the caller's call, not a parse accident.
  case "${AGENTCTL_REAP_GRACE:-}" in ''|*[!0-9]*) tries=25;; *) tries=$(( AGENTCTL_REAP_GRACE * 5 ));; esac
  i=0
  while [ "$i" -lt "$tries" ]; do
    pgrep -g "$pg" >/dev/null 2>&1 || { echo "reaped process group $pg (TERM)"; return 0; }
    sleep 0.2; i=$((i+1))
  done
  kill -KILL -- "-$pg" 2>/dev/null; sleep 0.2
  if pgrep -g "$pg" >/dev/null 2>&1; then
    echo "WARN: survivors in process group $pg after KILL: $(pgrep -g "$pg" 2>/dev/null | tr '\n' ' ')" >&2
    return 1
  fi
  echo "reaped process group $pg (KILL)"
}

# DONE persists as a filesystem fact: whichever observer (watch or status) first computes
# a terminal DONE drops this marker, so pure-file waiters and post-mortems recover the
# truth even if every notifying process was reaped (field-proposed 2026-07-28 — a stalled
# poller is silent, but a marker on disk needs nobody listening).
# Lifecycle: existence means THIS round of THIS session is believed done — start, steer
# (new round) and stop all clear it (review F1/F2: an identity-less marker inherited by a
# later same-name session or round is a durable false DONE). JSON goes through python
# (quotes/backslashes in globs stay parseable, F3) with tmp+rename (no torn read, F7);
# the meta re-check right before publish keeps a racing stop from resurrecting a marker.
# Publication is FENCED by attempt identity, and every identity file operation lives in ONE
# place (duplexctl's identity module): the marker is stamped with the ACTIVE identity and the
# record is re-read immediately before the write, so a watcher armed under attempt A can never
# publish a terminal conclusion for attempt B. Refusal prints the typed stale class, writes
# nothing, and returns 2 — an ambiguous identity is never allowed to read as DONE.
publish_terminal_marker() { # $1 session — stdout: typed line on refusal; rc 2 = refused
  "$PY" "$CTL" --run-dir "$DIR" identity publish "$1" --armed "$ARMED_ID"
}

identity_token() { # $1 session — opaque arm-time snapshot ("" = legacy session, unfenced)
  "$PY" "$CTL" --run-dir "$DIR" identity token "$1" 2>/dev/null
}

# Cleanup is a MUTATION of identity state and is refused when the shared lock cannot be
# acquired, so its exit code is load-bearing: swallowing it would let a reclaimed session name
# inherit its predecessor's authority — the exact class this whole module exists to fence.
identity_clear() { # $1 session — 0 = identity dropped, non-zero = refused (message on stdout)
  "$PY" "$CTL" --run-dir "$DIR" identity clear "$1" 2>&1
}

# The BLOCKED.md footer keeps the cross-engine ask-user protocol alive on the duplex lane:
# headless engines cannot prompt, so "on doubt, write BLOCKED.md and stop" maps to exit 4.
append_footer() { # $1 out-file  $2 cwd  $3 identity stamp file
  printf '\n\n---\nHEADLESS PROTOCOL\n%s\n%s\n%s\n%s\n' \
    'Briefly restate the files/contracts, scope, and main risk, then start work immediately. Do not wait for approval or interaction.' \
    'This session is non-interactive. Work from this message and stop when done; further instructions may arrive as new messages.' \
    "If genuinely blocked, write the blocker to $2/BLOCKED.md and stop." \
    "When you write that file, make its LAST line the exact contents of $3 — that stamp proves the blocker belongs to this attempt; an unstamped blocker still works but is fenced only by round freshness." >> "$1"
}

# THE provider list — generated by duplexctl from the one capability table. agentctl holds no
# provider knowledge of its own: allowlist, binary env override, default binary, pinned argv,
# whether unrecognized start args are forwarded (that forwarding IS omp/claude's declared
# resume surface) and which start flag drives a provider's resume route all arrive as
# `name|bin_env|default_bin|argv|extra_argv|resume_flag`. A second hand-maintained list here
# is exactly the drift WS3 exists to kill (cold review R1: a renamed launch branch survived
# every gate because the allowlist and the launch case were two separate opinions).
provider_row() { # $1 engine — stdout: the spec row, rc 1 = no such provider
  "$PY" "$CTL" providers --shell | awk -F'|' -v e="$1" '$1 == e { print; found = 1 }
                                                        END { exit found ? 0 : 1 }'
}
provider_names() { "$PY" "$CTL" providers | tr '\n' '|' | sed 's/|$//'; }

cmd_start() {
  ENG="${1:?usage}" ; S="${2:?session}" ; CWD="${3:?cwd}"; shift 3
  PROW="$(provider_row "$ENG")" || { echo "ERR: unknown engine '$ENG' ($(provider_names)) — see agentctl capabilities" >&2; exit 1; }
  P_BIN_ENV="${PROW#*|}"; P_BIN_ENV="${P_BIN_ENV%%|*}"
  P_REST="${PROW#*|*|}"; P_BIN="${P_REST%%|*}"
  P_REST="${P_REST#*|}"; P_ARGV="${P_REST%%|*}"
  P_REST="${P_REST#*|}"; P_EXTRA_OK="${P_REST%%|*}"
  P_RESUME_FLAG="${P_REST#*|}"
  case "$P_BIN_ENV" in ''|*[!A-Z0-9_]*) echo "ERR: provider spec for '$ENG' is malformed (bin env '$P_BIN_ENV')" >&2; exit 1;; esac
  GOAL=""; DELIV=""; PREFLIGHT=1; EXTRA=(); WORKFLOW=""; MAX_ROUNDS=""; MODEL=""; RESUME_THREAD=""; MODEL_TOKENS=0
  while [ "$#" -gt 0 ]; do case "$1" in
    --goal) GOAL="${2:?--goal needs a file}"; shift 2;;
    --deliverable) DELIV="${2:?--deliverable needs a glob}"; shift 2;;
    --no-preflight) PREFLIGHT=0; shift;;
    # pre-1.6.0 opt-in spelling; the gate is the default now, so it is accepted as a
    # no-op for one version (remembering a flag was the thing that kept failing).
    --require-preflight) shift;;
    --workflow) WORKFLOW="${2:?--workflow needs a value}"; shift 2;;
    --max-rounds) MAX_ROUNDS="${2:?--max-rounds needs N}"; shift 2;;
    --resume-thread) RESUME_THREAD="${2:?--resume-thread needs an id}"; shift 2;;
    --model) MODEL="${2:?--model needs an id}"; EXTRA[${#EXTRA[@]}]="$1"; EXTRA[${#EXTRA[@]}]="$2"; MODEL_TOKENS=$((MODEL_TOKENS+2)); shift 2;;
    --model=*) MODEL="${1#*=}"; EXTRA[${#EXTRA[@]}]="$1"; MODEL_TOKENS=$((MODEL_TOKENS+1)); shift;;
    *) EXTRA[${#EXTRA[@]}]="$1"; shift;;
  esac; done
  if [ -n "$WORKFLOW" ] || [ -n "$MAX_ROUNDS" ]; then
    [ "$WORKFLOW" = "review-loop" ] && [ -n "$MAX_ROUNDS" ] || { echo "ERR: --workflow review-loop and --max-rounds N must be provided together" >&2; exit 1; }
    case "$MAX_ROUNDS" in ''|*[!0-9]*) echo "ERR: --max-rounds must be a positive integer" >&2; exit 1;; esac
    [ "$MAX_ROUNDS" -gt 0 ] || { echo "ERR: --max-rounds must be a positive integer" >&2; exit 1; }
  fi
  [ -n "$GOAL" ] && [ -e "$GOAL" ] || { echo "ERR: --goal <file> required and must exist" >&2; exit 1; }
  if [ -n "$RESUME_THREAD" ] && [ "$P_RESUME_FLAG" != "--resume-thread" ]; then
    echo "ERR: --resume-thread only drives a provider whose resume capability declares it; '$ENG' does not — run 'agentctl capabilities' and read the resume note for $ENG" >&2; exit 1
  fi
  if [ "$PREFLIGHT" = 1 ]; then
    "$HERE/../goal-preflight.py" "$GOAL" || {
      echo "HINT: mechanical / forensic / pure-research goals opt out explicitly — re-run with --no-preflight" >&2
      exit 1; }
  fi
  [ -d "$CWD" ] || { echo "ERR: cwd not found: $CWD" >&2; exit 1; }
  CWD="$(cd "$CWD" && pwd -P)"
  mkdir -p "$DIR"

  # collisions: refuse ANY prior lane state or live tmux session BEFORE branching to an
  # engine — the round engine only knows its own state, so a codex start over crashed
  # duplex residue would create a second lane and mis-route every later verb (review
  # S2 2026-07-19).
  [ "$(lane_of "$S")" = none ] || { echo "ERR: session '$S' already exists ($(lane_of "$S") lane) — agentctl stop $S or pick a new name" >&2; exit 1; }
  tmux has-session -t "=$S" 2>/dev/null && { echo "ERR: tmux session '$S' already exists" >&2; exit 1; }

  FIFO="$DIR/$S.duplex.in"; EV="$DIR/$S.duplex.events.jsonl"
  ERR="$DIR/$S.duplex.stderr.log"; RC="$DIR/$S.duplex.rc"
  # mkfifo IS the atomic claim (EEXIST = concurrent start or crash residue): no rm -f
  # first — deleting the loser's view of the winner's fifo was a TOCTOU that could
  # orphan a just-started engine (review S2 2026-07-19). stop removes the fifo.
  if ! mkfifo "$FIFO" 2>/dev/null; then
    echo "ERR: session '$S' fifo already exists ($FIFO) — concurrent start, or crash residue: agentctl stop $S first" >&2; exit 1
  fi
  # the terminal record AND any debris of an interrupted publish share one lifecycle: a
  # leftover temp would otherwise make the NEXT attempt read PUBLISH_INTERRUPTED forever.
  # The temp name is session- and purpose-scoped (`.<s>.terminal.json-*.tmp`), so this glob can
  # never reach a sibling session's state.
  rm -f "$RC" "$DIR/$S.terminal.json" "$DIR"/".$S.terminal.json-"*.tmp; : > "$EV"; : > "$ERR"
  # a reclaimed name must not inherit its predecessor's authority: if the old identity cannot
  # be dropped, REFUSE to start rather than run a session over someone else's record
  if ! CLEAR_OUT="$(identity_clear "$S")"; then
    echo "ERR: cannot clear the previous identity for '$S' — $CLEAR_OUT" >&2
    echo "HINT: another process may hold the identity lock, or $DIR/$S.identity.lock is unreadable" >&2
    rm -f "$FIFO"; exit 1
  fi

  EXTRA_Q=""  # zero args to `printf ' %q'` would still format once → a literal '' engine arg
  [ "${#EXTRA[@]}" -gt 0 ] && EXTRA_Q="$(printf ' %q' "${EXTRA[@]}")"
  eval "BIN=\"\${$P_BIN_ENV:-}\""
  [ -n "$BIN" ] || BIN="$P_BIN"
  # a provider that does NOT forward extra argv takes its engine config over the protocol
  # (--model is captured into meta); ANY other argv is refused, never silently dropped
  if [ "$P_EXTRA_OK" != 1 ] && [ "${#EXTRA[@]}" -ne "$MODEL_TOKENS" ]; then
    echo "ERR: $ENG duplex takes engine config via protocol (--model/--resume-thread only) — unrecognized argv: ${EXTRA[*]}" >&2
    rm -f "$FIFO" "$DIR/$S.duplex.meta"; exit 1
  fi
  # extra_argv=0 providers still get EXTRA_Q appended: it is empty unless --model was
  # captured, and --model IS the one argv shape they accept.
  ECMD="$(q "$BIN")${P_ARGV:+ $P_ARGV}$EXTRA_Q"
  { printf 'engine=%s\ncwd=%s\n' "$ENG" "$CWD"
    [ -n "$DELIV" ] && printf 'deliverable=%s\n' "$DELIV"
    [ -n "$MODEL" ] && printf 'model=%s\n' "$MODEL"
    [ -n "$RESUME_THREAD" ] && printf 'resume_thread=%s\n' "$RESUME_THREAD"
    [ -n "$WORKFLOW" ] && printf 'workflow=%s\nmax_rounds=%s\n' "$WORKFLOW" "$MAX_ROUNDS"; } > "$DIR/$S.duplex.meta"

  # exec 3<> holds the fifo read-write so the engine's stdin NEVER sees EOF (both
  # engines exit on stdin close); engine runs as a child so the shell can record rc.
  # rc publishes via tmp+rename: `echo $? > rc` truncates first, and a classify racing
  # that window read an EMPTY rc — misreporting a clean exit as FAILED (review S2 2026-07-19).
  PANE="exec 3<>$(q "$FIFO"); $ECMD <&3 >> $(q "$EV") 2>> $(q "$ERR"); e=\$?; echo \$e > $(q "$RC").tmp && mv $(q "$RC").tmp $(q "$RC")"
  if ! tmux new-session -d -s "$S" -c "$CWD" "$PANE"; then
    rm -f "$FIFO" "$DIR/$S.duplex.meta"
    echo "ERR: tmux new-session failed for '$S' (nothing started)" >&2; exit 1
  fi

  # record the pane's process-group identity for reap-at-stop: pid alone is recyclable,
  # so pair it with the leader's start time; store neither if either read fails (a stop
  # with no fingerprint refuses stale-meta reaping rather than guessing).
  PANE_PID="$(tmux display-message -p -t "=$S:" '#{pane_pid}' 2>/dev/null)"
  PANE_LSTART="$(ps -p "${PANE_PID:-0}" -o lstart= 2>/dev/null | sed 's/ *$//')"
  [ -n "$PANE_PID" ] && [ -n "$PANE_LSTART" ] \
    && printf 'pane_pid=%s\npane_lstart=%s\n' "$PANE_PID" "$PANE_LSTART" >> "$DIR/$S.duplex.meta"
  # pin remain-on-exit off: inherited "on" keeps the session alive around a DEAD pane,
  # and stop's live #{pane_pid} read would hand reap an exited, recyclable pid while
  # the fingerprinted meta identity gets ignored (review S1). Our session, our option.
  tmux set-option -w -t "=$S:" remain-on-exit off 2>/dev/null || true

  if ! "$PY" "$CTL" --run-dir "$DIR" wait-ready "$S" --wait 20; then
    echo "ERR: engine handshake failed — cleaning up. stderr tail:" >&2
    tail -c 800 "$ERR" >&2 2>/dev/null || true
    tmux kill-session -t "=$S" 2>/dev/null; reap_tree "$PANE_PID" ""
    rm -f "$FIFO" "$DIR/$S.duplex.meta"
    exit 1
  fi

  PROMPT="$DIR/$S.duplex.prompt"
  cat "$GOAL" > "$PROMPT"; append_footer "$PROMPT" "$CWD" "$DIR/$S.identity.d/blocked-stamp.txt"
  "$PY" "$CTL" --run-dir "$DIR" send "$S" --verb prompt --file "$PROMPT" || {
    echo "ERR: goal delivery failed — engine up but prompt not accepted; inspect then agentctl stop $S" >&2; exit 2; }
  echo "started $ENG → duplex session '$S' (cwd $CWD; tmux supervises, protocol steers)"
  echo "events : $EV (raw stays on disk; status/watch print bounded summaries only)"
  echo "engine : $ENG — model/backend = engine default unless overridden in args:${EXTRA[*]:+ ${EXTRA[*]}}"
  echo "next   : agentctl watch $S   (blocking, run_in_background)  |  agentctl status $S  (one-shot)"
}

cmd_steer() {
  S="${1:?usage: agentctl steer <session> (-m TEXT | -f FILE) [--now|--replace] [-d G]}"; shift
  MODE=""; ARG=""; VERB="steer"; NEWDELIV=""
  while [ "$#" -gt 0 ]; do case "$1" in
    -m|-f) MODE="$1"; ARG="${2:?$1 needs a value}"; shift 2;;
    --now) VERB="steer-now"; shift;;
    --replace) VERB="replace"; shift;;
    -d|--deliverable) NEWDELIV="${2:?-d needs a glob}"; shift 2;;
    *) echo "ERR: unknown steer option '$1'" >&2; usage;;
  esac; done
  [ -n "$MODE" ] || usage
  case "$(lane_of "$S")" in
    duplex)
      [ "$MODE" = -f ] && { [ -e "$ARG" ] || { echo "ERR: file not found: $ARG" >&2; exit 1; }; }
      # a steer opens a new round: DONE is no longer a fact. Pre-clearing is the safe
      # direction — a missing marker sends waiters back to status (which re-writes it if
      # still DONE); a stale marker is a durable false DONE (review F1①).
      rm -f "$DIR/$S.terminal.json" "$DIR"/".$S.terminal.json-"*.tmp
      # -d rides duplexctl: applied atomically (key-scoped meta_update) only after a
      # successful delivery — the shell grep+mv snapshot could roll back a concurrent
      # sender's round counter (review S2 2026-07-19)
      if [ "$MODE" = -f ]; then exec "$PY" "$CTL" --run-dir "$DIR" send "$S" --verb "$VERB" --file "$ARG" ${NEWDELIV:+--deliverable "$NEWDELIV"}
      else exec "$PY" "$CTL" --run-dir "$DIR" send "$S" --verb "$VERB" --text "$ARG" ${NEWDELIV:+--deliverable "$NEWDELIV"}; fi ;;
    none) echo "ERR: unknown session '$S' (no duplex state)" >&2; exit 1 ;;
  esac
}

cmd_status() {
  S="${1:?usage: agentctl status <session>}"
  case "$(lane_of "$S")" in
    duplex)
      # snapshot the identity BEFORE classify: the publish below re-reads the record and
      # refuses if it rotated in between, so a conclusion computed under one attempt can
      # never be published under another (TOCTOU window closed).
      ARMED_ID="$(identity_token "$S")"
      msg="$("$PY" "$CTL" --run-dir "$DIR" classify "$S")"; rc=$?
      [ -n "$msg" ] && printf '%s\n' "$msg"   # a died classify says it all on stderr
      # one-shot status persists DONE only when the deliverable gate vouched for it —
      # a bare idle read at a turn boundary must not become durable truth (review F6);
      # sessions without a declared deliverable get their marker from watch's 2-stable read.
      if [ "$rc" = 0 ] && [ -n "$(meta_get "$S" deliverable)" ]; then
        pmsg="$(publish_terminal_marker "$S")"; prc=$?
        [ -n "$pmsg" ] && printf '%s\n' "$pmsg"
        # a refused publish means THIS verdict is not ours to publish: never report OK
        [ "$prc" = 0 ] || rc=2
      fi
      # RUNNING with nobody watching is the field's most expensive omission (start,
      # then forget to arm the watcher — 4 catches in one production day). Advisory
      # only: the typed line and the exit code are untouched.
      if [ "$rc" = 10 ] && ! watcher_alive "$S"; then
        echo "note: no watcher armed — arm: agentctl watch $S (run_in_background)"
        # The killed-notification can die with the host session; status is the verb the
        # orchestrator re-checks with, so the unresolved death is surfaced here.
        TOMB="$DIR/$S.watch.tombstone.jsonl"
        # Second liveness check right at the emit point: a re-arm racing this call has
        # already consumed the tombstone AND flipped liveness (cold-review F-01).
        if [ -f "$TOMB" ] && ! watcher_alive "$S"; then
          # single read + emptiness guard: a rotation racing between the -f test and the
          # read must not print an empty attribution (review F5)
          last="$(tail -1 "$TOMB" 2>/dev/null)"
          [ -n "$last" ] && echo "note: previous watcher killed externally — $last — killed ≠ worker dead"
          # The host reaps background tasks in batches (same-second double-kill, field
          # 2026-07-25). Correlation here is tombstone-mtime proximity only — honest
          # wording, no causality claim (cold-review F-02).
          peers=""
          for t in "$DIR"/*.watch.tombstone.jsonl; do
            [ -f "$t" ] && [ "$t" != "$TOMB" ] || continue
            p="${t##*/}"; p="${p%.watch.tombstone.jsonl}"
            watcher_alive "$p" && continue
            "$PY" -c 'import os,sys;sys.exit(0 if abs(os.path.getmtime(sys.argv[1])-os.path.getmtime(sys.argv[2]))<=120 else 1)' \
              "$t" "$TOMB" 2>/dev/null && peers="$peers $p"
          done
          [ -n "$peers" ] && echo "note: watchers of:$peers also died within ±120s (likely one reap) — re-arm each"
        fi
      fi
      exit "$rc" ;;
    none)   echo "ERR: unknown session '$S'" >&2; exit 1 ;;
  esac
}

# every watch exit prints the verdict twice: the typed `=== … ===` line for humans and
# a final `EXIT=<n>` for pipes — a wrapper (tee / subshell / background harness) that
# swallows the process exit code can still parse the verdict off the last line.
watch_exit() { # $1 rc
  echo "EXIT=$1"; exit "$1"
}

cmd_watch() {
  S="${1:?usage: agentctl watch <session>}"
  [ "$(lane_of "$S")" = duplex ] || { echo "ERR: unknown session '$S'" >&2; exit 1; }
  WPID="$DIR/$S.duplex.watch.pid"
  echo $$ > "$WPID"; trap 'rm -f "$WPID"' EXIT
  consume_tombstone "$S"
  # External kills are non-deterministic and the sender is invisible from inside the
  # sandbox (field report 2026-07-23: TERM ~3-5min in, other watchers untouched). Leave
  # an attributable tombstone and clean the pid file so the death is diagnosable and
  # never lingers as a live-looking watcher.
  on_sig() { # $1 signal-name  $2 exit-code
    printf '{"ts":"%s","event":"watcher-killed","signal":"%s","ppid":%s,"uptime_s":%s}\n' \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" "$PPID" "$SECONDS" >> "$DIR/$S.watch.tombstone.jsonl"
    rm -f "$WPID"; exit "$2"
  }
  trap 'on_sig TERM 143' TERM; trap 'on_sig INT 130' INT
  POLL="${AGENT_WATCH_POLL_SECS:-15}"; MAX="${AGENT_WATCH_MAX_POLLS:-240}"
  # ENGINE-SILENT bound: a steer was delivered but the engine produced zero output for
  # ~2min. The duplex analog of the old NO-HOOK exit 8 — report honestly, never guess.
  SILENT_MAX="${AGENT_WATCH_SILENT_POLLS:-8}"
  # arm-time identity snapshot: this watcher may only ever publish a conclusion for the
  # identity it armed under (re-verified inside publish, immediately before the write).
  ARMED_ID="$(identity_token "$S")"
  echo "=== [$S] DUPLEX-WATCH ARMED at $(date '+%H:%M:%S') (stateless — safe to kill and re-run) ==="
  idle=0; silent=0; tmo=0; i=1
  while [ "$i" -le "$MAX" ]; do
    msg="$("$PY" "$CTL" --run-dir "$DIR" classify "$S")"; rc=$?
    case "$rc" in
      10)
        case "$msg" in *"no output since last steer"*) silent=$((silent+1));; *) silent=0;; esac
        if [ "$silent" -ge "$SILENT_MAX" ]; then
          echo "=== [$S] ENGINE-SILENT at $(date '+%H:%M:%S') — steer delivered but no engine output ~2min; inspect $DIR/$S.duplex.stderr.log ==="
          watch_exit 8
        fi
        idle=0; tmo=0 ;;
      0|6)
        # stability: require 2 consecutive terminal reads — a turn boundary right
        # before an auto-consumed queued message must not read as terminal.
        idle=$((idle+1)); silent=0; tmo=0
        if [ "$idle" -ge 2 ]; then
          if [ "$rc" = 0 ]; then
            pmsg="$(publish_terminal_marker "$S")"; prc=$?
            [ -n "$pmsg" ] && msg="$msg
$pmsg"
            [ "$prc" = 0 ] || rc=2   # armed under another identity: publish nothing, report the class
          fi
          echo "=== [$S] $msg ==="; watch_exit "$rc"
        fi ;;
      8)
        # classify's own control-plane timeout — transient lock/engine contention is
        # possible, so require 2 consecutive reads before killing the watch (mirrors
        # the idle stability rule; review: a single 8 must not fell the watcher when
        # watch's own ENGINE-SILENT needs 8 consecutive silent polls).
        tmo=$((tmo+1)); idle=0; silent=0
        if [ "$tmo" -ge 2 ]; then echo "=== [$S] $msg ==="; watch_exit 8; fi ;;
      *) echo "=== [$S] $msg ==="; watch_exit "$rc" ;;
    esac
    [ $((i % 12)) -eq 0 ] && echo "[$S] heartbeat iter $i $(date '+%H:%M:%S') — $msg"
    # sleep backgrounded + wait: `wait` is signal-interruptible; a bare foreground sleep
    # defers a trapped TERM until it finishes (probed 2026-07-23: 14s) — the tombstone
    # would lose the race against a TERM→KILL grace window.
    i=$((i+1)); sleep "$POLL" & wait $!
  done
  echo "=== [$S] WATCH TIMEOUT — engine still active; re-run watch or investigate ==="; watch_exit 7
}

cmd_stop() {
  S="${1:?usage: agentctl stop <session>}"
  case "$(lane_of "$S")" in
    duplex)
      # reap identity BEFORE the kill and the cleanup: the live pane pid is only
      # trustworthy while the pane is ALIVE — with remain-on-exit the session outlives
      # a dead pane and #{pane_pid} reports an exited, recyclable pid (review S1); dead
      # or no pane falls back to the recorded pid+lstart fingerprint (workers adopted
      # by PID 1 keep the pgid — the leak class).
      live="$(tmux display-message -p -t "=$S:" '#{pane_dead} #{pane_pid}' 2>/dev/null)"
      live_pg=""; case "$live" in "0 "*) live_pg="${live#0 }";; esac
      meta_pg="$(meta_get "$S" pane_pid)"; meta_ls="$(meta_get "$S" pane_lstart)"
      tmux kill-session -t "=$S" 2>/dev/null && echo "killed tmux session $S" || echo "no tmux session $S"
      # false-DONE sentinel, part 1: capture the terminal marker's mtime BEFORE the
      # cleanup below deletes it; the events side is sampled AFTER the reap (part 2)
      # — a straggler child holding the events fd can write between the kill and the
      # reap, and sampling early missed exactly that target class. stat dialects are
      # probed SEPARATELY and validated numeric: a failed dialect's stdout must never
      # leak into the arithmetic (GNU `stat -f` prints filesystem status to stdout
      # and still fails, poisoning a shared command substitution).
      stat_mtime() { # $1 file — prints epoch seconds, or nothing on probe failure
        sm_v="$(stat -f %m "$1" 2>/dev/null)"
        case "$sm_v" in ''|*[!0-9]*) sm_v="$(stat -c %Y "$1" 2>/dev/null)";; esac
        case "$sm_v" in ''|*[!0-9]*) return 1;; esac
        printf '%s\n' "$sm_v"
      }
      SENT_MM=""
      [ -f "$DIR/$S.terminal.json" ] && SENT_MM="$(stat_mtime "$DIR/$S.terminal.json" || true)"
      # control state goes down BEFORE the reap: the terminal-marker guard (meta
      # re-check right before publish) prices in a µs kill→cleanup gap, and a
      # grace-long reap in between would stretch it to seconds (review S3). Trade-off:
      # a same-name start may now begin while the old tree is still being reaped —
      # disjoint pgids plus the self-group refusal keep the kills from crossing.
      rm -f "$DIR/$S.duplex.in" "$DIR/$S.duplex.meta" "$DIR/$S.duplex.round-started" \
            "$DIR/$S.duplex.wlock" "$DIR/$S.duplex.prompt" "$DIR/$S.duplex.sent-offset" \
            "$DIR/$S.duplex.write-intent" "$DIR/$S.duplex.watch.pid" \
            "$DIR/$S.terminal.json" "$DIR"/".$S.terminal.json-"*.tmp 2>/dev/null
      # the attempt is over: its authority should die with the control state. A refused clear
      # must be SAID OUT LOUD — the session is down but its identity still holds authority, so
      # a same-name restart would be refused rather than silently inheriting it.
      ID_RC=0
      CLEAR_OUT="$(identity_clear "$S")" || ID_RC=1
      [ "$ID_RC" = 0 ] || echo "WARN: identity state was NOT cleared for '$S' — $CLEAR_OUT" >&2
      consume_tombstone "$S"
      echo "removed duplex control state; kept for post-mortem: $DIR/$S.duplex.events.jsonl, .stderr.log, .rc, .sent-journal (replay-corpus sidecar)"
      if [ -n "$live_pg" ]; then reap_tree "$live_pg" ""
      else reap_tree "$meta_pg" "$meta_ls"; fi
      REAP_RC=$?
      # false-DONE sentinel, part 2 (advisory — must never change stop's rc): with the
      # tree fully reaped nothing can write the events file anymore, so THIS is the
      # honest sampling point. events growing >2s past the marker = the round was
      # concluded while the engine still spoke (silent-misfire class made loud); +2s
      # prices in the marker-write vs final-flush race. The copy is the replay-corpus
      # candidate (test/corpus/, local-only).
      if [ -n "$SENT_MM" ] && [ -f "$DIR/$S.duplex.events.jsonl" ]; then
        SENT_EM="$(stat_mtime "$DIR/$S.duplex.events.jsonl" || true)"
        if [ -n "$SENT_EM" ] && [ "$SENT_EM" -gt $((SENT_MM + 2)) ]; then
          echo "SENTINEL: events grew $((SENT_EM - SENT_MM))s past the terminal marker — possible false-DONE window or unknown continuation; keep $DIR/$S.duplex.events.jsonl and consider the replay corpus" >&2
        fi
      fi
      # a refused identity clear is a real failure of stop's contract, even though the engine
      # and its process group are gone: the caller must know the name is not free to reuse
      [ "$ID_RC" = 0 ] || exit 1
      exit "$REAP_RC" ;;
    none)
      # no lane meta: clean bare tmux AND orphan duplex claims (crash residue like a
      # stray fifo/write-intent) — this IS the recovery path the start error advertises
      cleaned=0; reap_rc=0
      if tmux has-session -t "=$S" 2>/dev/null; then
        live="$(tmux display-message -p -t "=$S:" '#{pane_dead} #{pane_pid}' 2>/dev/null)"
        live_pg=""; case "$live" in "0 "*) live_pg="${live#0 }";; esac
        tmux kill-session -t "=$S" 2>/dev/null; reap_tree "$live_pg" "" || reap_rc=1
        echo "killed bare tmux session $S"; cleaned=1
      fi
      for f in "$DIR/$S.duplex.in" "$DIR/$S.duplex.wlock" "$DIR/$S.duplex.prompt" \
               "$DIR/$S.duplex.sent-offset" "$DIR/$S.duplex.round-started" \
               "$DIR/$S.duplex.write-intent" "$DIR/$S.duplex.watch.pid" \
               "$DIR/$S.terminal.json" "$DIR"/".$S.terminal.json-"*.tmp; do
        [ -e "$f" ] && { rm -f "$f"; cleaned=1; }
      done
      # orphan identity must not outlive the residue it belonged to
      CLEAR_OUT="$(identity_clear "$S")" || { reap_rc=1
        echo "WARN: identity state was NOT cleared for '$S' — $CLEAR_OUT" >&2; }
      if [ "$cleaned" = 1 ]; then echo "removed orphan session residue for '$S'"; exit "$reap_rc"
      elif [ -e "$DIR/$S.duplex.events.jsonl" ] || [ -e "$DIR/$S.duplex.rc" ]; then
        # idempotent re-stop: session already cleaned, only post-mortem artifacts remain
        echo "already stopped: only post-mortem artifacts remain for '$S'"
      else echo "ERR: unknown session '$S' (no lane state, no tmux session, no residue)" >&2; exit 1; fi ;;
  esac
}

case "${1:-}" in
  start)  shift; cmd_start "$@" ;;
  steer)  shift; cmd_steer "$@" ;;
  status) shift; cmd_status "$@" ;;
  watch)  shift; cmd_watch "$@" ;;
  capabilities) shift
          case "${1:-}" in
            "") "$PY" "$CTL" capabilities ;;
            --json) "$PY" "$CTL" capabilities --json ;;
            *) echo "ERR: unknown capabilities option '$1' (only --json)" >&2; exit 1 ;;
          esac ;;
  stop)   shift; cmd_stop "$@" ;;
  ""|-h|--help) usage ;;
  *) echo "ERR: unknown subcommand '${1}'" >&2; usage ;;
esac
