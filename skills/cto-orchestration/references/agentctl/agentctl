#!/usr/bin/env bash
# agentctl — unified control surface for headless worker agents (duplex-lane era).
#
#   agentctl start  <omp|codex|claude> <session> <cwd> --goal F [--deliverable G]
#                   [--no-preflight] [--review] [engine args...]
#   agentctl steer  <session> (-m TEXT | -f FILE) [--now | --replace] [-d|--deliverable G]
#   agentctl status <session>            # one-shot typed state (exit = verdict)
#   agentctl watch  <session> [--inline]  # block until terminal; typed exits (vocabulary below)
#   agentctl stop   <session> [cwd]      # end + clean control state (events kept for post-mortem)
#   agentctl capabilities [--json]       # runtime-generated provider capability contract
#   agentctl states [--json]             # runtime-generated typed state vocabulary
#   agentctl inventory --dry-run         # read-only candidate overview (never kills anything)
#
# ONE lane, three engines (unified 2026-07-19): each runs its native duplex stdio protocol
# long-lived in a tmux supervisor pane; steering is a protocol frame on the session fifo
# (duplexctl = single flock-serialized writer) and capability gaps REFUSE instead of forking
# lanes. tmux SUPERVISES only. NOT a transaction system: concurrent same-name starts are an
# orchestrator bug, sequential ones are refused mechanically. The typed exit vocabulary is
# NOT copied here: `agentctl states` prints it (and `--json` publishes it), generated from
# duplexctl's TYPED_STATES. Untyped: 1 usage/SESSION-GONE, 3 send-unconfirmed.
# `agentctl watch-daemon <session>` is INTERNAL: the sensing loop tmux runs for supervised watch.
#
# THIS SCRIPT IS A THIN ENTRY, AND THAT IS A CONTRACT: usage + argument parsing, tmux and
# process-group glue, the goal-file existence check, and `$CTL` dispatch with the exit code
# forwarded untouched. Every JUDGEMENT is in python — nothing here parses a JSON record, a
# lease, a terminal record, the events stream or the rc file, does timestamp arithmetic, or
# branches on what a classify verdict SAYS (guard: agentctl-structure.test.sh §S4/§S5).
set -uo pipefail
# $0 may be a PATH symlink: follow the chain before dirname, else CTL resolves beside the link
SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
SELFABS="$HERE/$(basename "$SELF")"   # the supervisor pane relaunches this exact script
DIR="${AGENT_WATCH_DIR:-/tmp/agent-watch-run}"
CTL="$HERE/duplexctl.py"
PY="${AGENTCTL_PYTHON:-python3}"
ARMED_ID=""   # arm-time snapshot of the active identity; captured by watch before it senses
q() { printf %q "$1"; }
ctl() { "$PY" "$CTL" --run-dir "$DIR" "$@"; }
meta_get() { sed -n "s/^$2=//p" "$DIR/$1.duplex.meta" 2>/dev/null | head -1; }
usage() {
  echo "usage: agentctl start <omp|codex|claude> <session> <cwd> --goal F [--deliverable G] [--no-preflight] [--review] [engine args...]" >&2
  echo "       agentctl steer <session> (-m TEXT | -f FILE) [--now | --replace] [-d G]" >&2
  echo "       agentctl status <session> | watch <session> [--inline] | stop <session> [cwd] | capabilities [--json] | states [--json]" >&2
  echo "       agentctl inventory --dry-run   # read-only; no other spelling exists" >&2
  exit 1
}

# duplex sessions have .duplex.meta (the only lane since 2026-07-19 unification).
lane_of() { # $1 session
  if [ -f "$DIR/$1.duplex.meta" ]; then echo duplex; else echo none; fi
}

# tmux kill-session only signals the pane leader: children that outlive it are adopted by PID 1
# and leak (field 2026-07-28: 43 sessions left 8 workers + 16 grandchildren). The pane is its
# own session+group leader and POSIX reserves the pgid while ANY member lives, so the group is
# the ownership boundary: TERM, grace, KILL, verify — one pgid we own, never a global kill.
reap_tree() { # $1 pane_pid (== pgid)  $2 expected leader lstart ("" = pid read live, skip check)
  local pg="$1" want="$2" have i tries
  case "$pg" in ''|*[!0-9]*) return 0;; esac
  # lower bounds are load-bearing: Linux `pgrep -g 0` is OUR group, and reaping it is suicide
  [ "$pg" -gt 1 ] || return 0
  [ "$pg" = "$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')" ] && return 0
  pgrep -g "$pg" >/dev/null 2>&1 || return 0
  if [ -n "$want" ]; then
    # stale meta: the pgid is a stranger's only if the LEADER pid was recycled after our whole
    # tree died, so its start time is the fingerprint (dead leader + live members = still ours)
    have="$(ps -p "$pg" -o lstart= 2>/dev/null | sed 's/ *$//')"
    if [ -n "$have" ] && [ "$have" != "$want" ]; then
      echo "WARN: pgid $pg leader started '$have' ≠ recorded '$want' (pid recycled) — not ours, not reaping" >&2
      return 0
    fi
  fi
  kill -TERM -- "-$pg" 2>/dev/null
  # non-numeric falls back to the 5s default; an explicit 0 means NO grace — caller's call.
  case "${AGENTCTL_REAP_GRACE:-}" in ''|*[!0-9]*) tries=25;; *) tries=$(( AGENTCTL_REAP_GRACE * 5 ));; esac
  i=0
  while [ "$i" -lt "$tries" ]; do
    pgrep -g "$pg" >/dev/null 2>&1 || { echo "reaped process group $pg (TERM)"; return 0; }
    sleep 0.2; i=$((i+1))
  done
  kill -KILL -- "-$pg" 2>/dev/null; sleep 0.2
  if pgrep -g "$pg" >/dev/null 2>&1; then
    echo "WARN: survivors in process group $pg after KILL: $(pgrep -g "$pg" 2>/dev/null | tr '\n' ' ')" >&2
    return 1
  fi
  echo "reaped process group $pg (KILL)"
}

# Escaped children are OUTSIDE the pane's group by construction (setsid / double fork), so the
# group-scoped reap above cannot see them and they outlive the stop (field 2026-08: one stop
# left 32 MCP children, ~700MB, oldest 6 days). These two calls bracket the reap and REPORT
# that gap on stderr — shared verbatim by both stop branches. They add NO signal of any kind:
# the snapshot is evidence, never a kill list, a recycled pid is not a survivor, and a probe
# that cannot answer prints [unknown] rather than letting silence read as clean. Judgement is
# duplexctl's (thin-entry contract); the shell only brackets the reap with it.
SURV_SNAP=""
survivor_probe() { # $1 session  $2 pane pgid ("" = no pane to probe: no snapshot, no advisory)
  SURV_SNAP=""
  [ -n "${2:-}" ] || return 0
  mkdir -p "$DIR" 2>/dev/null
  SURV_SNAP="$DIR/.$1.stop-probe.json"
  rm -f "$SURV_SNAP"
  ctl stop-probe "$1" --pane-pid "$2" --snapshot "$SURV_SNAP" >/dev/null 2>&1 || true
  return 0
}
survivor_advise() { # $1 session — stderr advisory only; never signals, never touches stop's rc
  [ -n "$SURV_SNAP" ] || return 0
  ctl stop-survivors "$1" --snapshot "$SURV_SNAP" || true
  rm -f "$SURV_SNAP"; SURV_SNAP=""
  return 0
}

# The BLOCKED.md footer IS the ask-user protocol: headless engines cannot prompt, so "on doubt,
# write BLOCKED.md and stop" maps to exit 4. Byte-for-byte the runtime understanding gate.
# The old wording ("do not wait for approval or interaction" + "if GENUINELY blocked") read as a
# licence to self-approve past a contract STOP gate — two workers did exactly that, same day,
# different goals. A contract gate is not interaction, and holding one is not a
# fallback path: it is the delivery action. Both halves are load-bearing, do not compress.
# The "unless" clause consumes the kernel's branch predicate (orchestrator-core §3): whether to
# wait is decided by what the contract PROMISED, never by who happens to be watching. Silence in
# the contract means start — the failure cost of a bounded false start beats deadlocking every
# lane that never promised a handshake.
# Every byte here is paid once per session and competes with the goal for attention, so the
# budget is a gate (test/context-budget.test.sh), not a good intention. Two things were cut when
# the write-the-file and stamp-the-file sentences merged: the duplicated "when you write that
# file" lead-in, and the note that an unstamped blocker still works. The latter is true — the
# runtime keeps accepting one, and test/agentctl-identity.test.sh N2 holds that behaviour — but
# telling the worker its stamp is optional buys nothing it can act on and weakens the instruction
# that follows. Reader-facing rationale belongs here in the source, not in the injected frame.
append_footer() { # $1 out-file  $2 cwd  $3 identity stamp file  $4 deliverable glob ("" = none)
  # The deliverable sentence is injected ONLY when one was declared (review 2026-08-17 B1:
  # an unconditional sentence told no-deliverable sessions to write a file that does not
  # exist — the runtime contract must never lie to a legal path). GENERIC wording, no glob
  # (review R2): the footer is a one-shot frame while `steer -d` can move the deliverable
  # later — naming the start-time glob would order the worker to write a file the watcher
  # no longer checks. Known boundary: a session started WITHOUT a deliverable that gains
  # one via `steer -d` never gets this sentence — the steer text itself must name the
  # artifact (goal-template's 交付物 line does; runtime does not re-inject footers).
  local line2='This session is non-interactive. Work from this message and stop when done; further instructions may arrive as new messages.'
  [ -n "${4:-}" ] && line2='This session is non-interactive. Work from this message and stop when done; results go IN the declared deliverable file — chat output is not delivery. Further instructions may arrive as new messages.'
  printf '\n\n---\nHEADLESS PROTOCOL\n%s\n%s\n%s\n' \
    'Briefly restate the files/contracts, scope, and main risk. Unless the goal contract promises to review that restatement before work begins, start work immediately — do not idle waiting for approval to begin.' \
    "$line2" \
    "If blocked, or when the goal contract tells you to stop and wait for the orchestrator (a promised pre-work review is such a gate — there you write the restatement itself), write it to $2/BLOCKED.md with the exact contents of $3 as its LAST line, then stop. That file IS how you hold a gate in a non-interactive session — a small blast radius or an easy rollback never licenses self-approval past one." >> "$1"
}

# THE provider list — generated by duplexctl from the one capability table. agentctl holds no
# provider knowledge of its own: allowlist, bin env, default binary, pinned argv, argv
# forwarding (= omp/claude's resume surface) and the resume flag all arrive as one row. A
# second, hand-maintained list here IS the drift the one-table rule exists to kill.
provider_row() { # $1 engine — stdout: the spec row, rc 1 = no such provider
  "$PY" "$CTL" providers --shell | awk -F'|' -v e="$1" '$1 == e { print; found = 1 }
                                                        END { exit found ? 0 : 1 }'
}
provider_names() { "$PY" "$CTL" providers | tr '\n' '|' | sed 's/|$//'; }

# Parameter-surface VALUE judgement (meta-line safety + the review seat's deliverable fence) is
# duplexctl's: `ctl check-params` owns both rules and prints its own refusal, because both are
# properties this shell does not own — the meta file format and the deliverable fence. Called
# before the start owns a fifo / meta / tmux session, so a refusal leaves nothing behind.

cmd_start() {
  ENG="${1:?usage}" ; S="${2:?session}" ; CWD="${3:?cwd}"; shift 3
  PROW="$(provider_row "$ENG")" || { echo "ERR: unknown engine '$ENG' ($(provider_names)) — see agentctl capabilities" >&2; exit 1; }
  P_BIN_ENV="${PROW#*|}"; P_BIN_ENV="${P_BIN_ENV%%|*}"
  P_REST="${PROW#*|*|}"; P_BIN="${P_REST%%|*}"
  P_REST="${P_REST#*|}"; P_ARGV="${P_REST%%|*}"
  P_REST="${P_REST#*|}"; P_EXTRA_OK="${P_REST%%|*}"
  P_REST="${P_REST#*|}"; P_RESUME_FLAG="${P_REST%%|*}"
  # `${var#*|}` returns the string UNCHANGED when there is no delimiter left, so an older
  # SIX-field row handed the resume flag over AS the review tier: `--review` was then accepted
  # and the banner claimed a sandbox the producer never promised — a permission fail-open on the
  # exact compatibility path (review R1 B3). Field 7 exists only if a delimiter remains.
  # Empty = this provider declares no OS sandbox tier, which is what makes `--review` a typed
  # refusal below rather than a flag that quietly does nothing.
  case "$P_REST" in *"|"*) P_REVIEW_SANDBOX="${P_REST#*|}";; *) P_REVIEW_SANDBOX="";; esac
  case "$P_BIN_ENV" in ''|*[!A-Z0-9_]*) echo "ERR: provider spec for '$ENG' is malformed (bin env '$P_BIN_ENV')" >&2; exit 1;; esac
  GOAL=""; DELIV=""; PREFLIGHT=1; EXTRA=(); WORKFLOW=""; MAX_ROUNDS=""; MODEL=""; RESUME_THREAD=""; MODEL_TOKENS=0; REVIEW=""
  while [ "$#" -gt 0 ]; do case "$1" in
    --goal) GOAL="${2:?--goal needs a file}"; shift 2;;
    --deliverable) DELIV="${2:?--deliverable needs a glob}"; shift 2;;
    --no-preflight) PREFLIGHT=0; shift;;
    # pre-1.6.0 opt-in spelling; the gate is the default now — accepted as a no-op for one version
    --require-preflight) shift;;
    --workflow) WORKFLOW="${2:?--workflow needs a value}"; shift 2;;
    --max-rounds) MAX_ROUNDS="${2:?--max-rounds needs N}"; shift 2;;
    --resume-thread) RESUME_THREAD="${2:?--resume-thread needs an id}"; shift 2;;
    --review) REVIEW=1; shift;;
    --model) MODEL="${2:?--model needs an id}"; EXTRA[${#EXTRA[@]}]="$1"; EXTRA[${#EXTRA[@]}]="$2"; MODEL_TOKENS=$((MODEL_TOKENS+2)); shift 2;;
    # an empty value is not a model: without this the flag zeroes MODEL, meta gets no model=
    # line, the pinned-argv rule drops the token, and the operator is told nothing at all
    --model=) echo "ERR: --model= needs an id — pass --model <id>, or omit the flag to take the engine default" >&2; exit 1;;
    --model=*) MODEL="${1#*=}"; EXTRA[${#EXTRA[@]}]="$1"; MODEL_TOKENS=$((MODEL_TOKENS+1)); shift;;
    *) EXTRA[${#EXTRA[@]}]="$1"; shift;;
  esac; done
  if [ -n "$WORKFLOW" ] || [ -n "$MAX_ROUNDS" ]; then
    [ "$WORKFLOW" = "review-loop" ] && [ -n "$MAX_ROUNDS" ] || { echo "ERR: --workflow review-loop and --max-rounds N must be provided together" >&2; exit 1; }
    case "$MAX_ROUNDS" in ''|*[!0-9]*) echo "ERR: --max-rounds must be a positive integer" >&2; exit 1;; esac
    [ "$MAX_ROUNDS" -gt 0 ] || { echo "ERR: --max-rounds must be a positive integer" >&2; exit 1; }
  fi
  [ -n "$GOAL" ] && [ -e "$GOAL" ] || { echo "ERR: --goal <file> required and must exist" >&2; exit 1; }
  # -s: an EXISTING empty goal (/dev/null included) is a contract with no content — the seat
  # correctly refuses to work and a whole round burns on BLOCKED-cleanup-recontract (field n=3)
  [ -s "$GOAL" ] || { echo "ERR: --goal file is empty ($GOAL) — an empty contract dispatches a seat with nothing to do; write the goal first" >&2; exit 1; }
  # the review-tier refusals below stay HERE: they read the generated provider spec, which is
  # this shell's own input, and they decide nothing about a value's content
  if [ -n "$RESUME_THREAD" ] && [ "$P_RESUME_FLAG" != "--resume-thread" ]; then
    echo "ERR: --resume-thread only drives a provider whose resume capability declares it; '$ENG' does not — run 'agentctl capabilities' and read the resume note for $ENG" >&2; exit 1
  fi
  # --model with --resume-thread is not a supported pair, and a silent winner is the worst
  # possible answer: the resume handshake sends the threadId alone (a thread keeps the model
  # it was created with), so the requested model would be written to meta and then consumed
  # by nobody. Refused HERE — at the parameter surface, before this start owns a fifo, a meta
  # file, a tmux session or a handshake.
  if [ -n "$RESUME_THREAD" ] && [ -n "$MODEL" ]; then
    echo "ERR: --model cannot be combined with --resume-thread — a resumed thread keeps the model it was started with, so '$MODEL' would be dropped in silence: drop --model to resume thread '$RESUME_THREAD' on its own model, or drop --resume-thread to start a NEW thread on '$MODEL'" >&2
    exit 1
  fi
  # `--review` marks the review seat and selects its sandbox tier from the provider spec.
  # Two refusals, both HERE at the parameter surface — before this start owns a fifo, a meta
  # file, a tmux session or a handshake:
  #  * a provider that declares no tier — the lane must not accept a permission request it
  #    cannot deliver (an unhandled flag forwarded to an extra_argv engine is not a refusal).
  #  * with --resume-thread — thread/resume sends the threadId ALONE, so a resumed thread
  #    keeps its creation-time tier: `--review` here would stamp review=1 into meta and
  #    print a review banner for a thread whose start never selected the review tier —
  #    the lane's own record would misdescribe the thread. Holds even with tiers unified.
  if [ -n "$REVIEW" ] && [ -z "$P_REVIEW_SANDBOX" ]; then
    echo "ERR: --review needs a provider with an OS sandbox tier; '$ENG' declares none — the lane pins no sandbox for it at all, so there is nothing to select. Run 'agentctl capabilities' and read the permissionEnforcement row for $ENG; the review seat is codex" >&2
    exit 1
  fi
  if [ -n "$REVIEW" ] && [ -n "$RESUME_THREAD" ]; then
    echo "ERR: --review cannot be combined with --resume-thread — thread/resume carries only the threadId, so a resumed thread keeps its creation-time tier: stamping review=1 on it would make the lane's meta and banner claim a review dispatch the handshake never made. Drop --resume-thread to start a NEW review thread, or drop --review to continue thread '$RESUME_THREAD' as-is" >&2
    exit 1
  fi
  if [ "$PREFLIGHT" = 1 ]; then
    "$HERE/../goal-preflight.py" "$GOAL" || {
      echo "HINT: mechanical / forensic / pure-research goals opt out explicitly — re-run with --no-preflight" >&2
      exit 1; }
  fi
  [ -d "$CWD" ] || { echo "ERR: cwd not found: $CWD" >&2; exit 1; }
  CWD="$(cd "$CWD" && pwd -P)"
  # every value that will reach meta, plus the review seat's deliverable fence, judged in ONE
  # duplexctl call against the NORMALIZED cwd — comparing against the caller's spelling would
  # let a symlinked or dot-laden cwd argument decide where the fence boundary is
  ctl check-params --gate start --cwd "$CWD" ${REVIEW:+--review} \
     --deliverable "$DELIV" --model "$MODEL" --resume-thread "$RESUME_THREAD" \
     --workflow "$WORKFLOW" || exit 1
  mkdir -p "$DIR"

  # collisions: refuse ANY prior lane state or live tmux session BEFORE branching to an engine
  [ "$(lane_of "$S")" = none ] || { echo "ERR: session '$S' already exists ($(lane_of "$S") lane) — agentctl stop $S or pick a new name" >&2; exit 1; }
  tmux has-session -t "=$S" 2>/dev/null && { echo "ERR: tmux session '$S' already exists" >&2; exit 1; }

  FIFO="$DIR/$S.duplex.in"; EV="$DIR/$S.duplex.events.jsonl"
  ERR="$DIR/$S.duplex.stderr.log"; RC="$DIR/$S.duplex.rc"
  # mkfifo IS the atomic claim (EEXIST = concurrent start or crash residue); no rm -f first —
  # that TOCTOU orphaned a just-started engine. stop unlinks the fifo.
  if ! mkfifo "$FIFO" 2>/dev/null; then
    echo "ERR: session '$S' fifo already exists ($FIFO) — concurrent start, or crash residue: agentctl stop $S first" >&2; exit 1
  fi
  # record + publish debris share one lifecycle (else the NEXT attempt reads PUBLISH_INTERRUPTED
  # forever); the temp glob is session-scoped, so it cannot reach a sibling
  rm -f "$RC" "$DIR/$S.terminal.json" "$DIR"/".$S.terminal.json-"*.tmp \
        "$DIR/$S.terminal.consumed.json"; : > "$EV"; : > "$ERR"
  # nor the PREVIOUS life's sensing loop: an orphan supervisor would classify under a dead lease
  retire_supervisor "$S"
  # nor its predecessor's authority: an identity that cannot be dropped REFUSES the start
  if ! CLEAR_OUT="$(ctl identity clear "$S" 2>&1)"; then
    echo "ERR: cannot clear the previous identity for '$S' — $CLEAR_OUT" >&2
    echo "HINT: another process may hold the identity lock, or $DIR/$S.identity.lock is unreadable" >&2
    rm -f "$FIFO"; exit 1
  fi

  EXTRA_Q=""  # zero args to `printf ' %q'` would still format once → a literal '' engine arg
  [ "${#EXTRA[@]}" -gt 0 ] && EXTRA_Q="$(printf ' %q' "${EXTRA[@]}")"
  eval "BIN=\"\${$P_BIN_ENV:-}\""
  [ -n "$BIN" ] || BIN="$P_BIN"
  # extra_argv=0: engine config rides the protocol (--model into meta), any other argv REFUSED
  if [ "$P_EXTRA_OK" != 1 ] && [ "${#EXTRA[@]}" -ne "$MODEL_TOKENS" ]; then
    echo "ERR: $ENG duplex takes engine config via protocol (--model/--resume-thread/--review only) — unrecognized argv: ${EXTRA[*]}" >&2
    rm -f "$FIFO" "$DIR/$S.duplex.meta"; exit 1
  fi
  # extra_argv=0: argv stays PINNED — model rides the protocol only (meta model= is consumed
  # by the engine handshake, e.g. codex thread/start params). Appending --model to argv killed
  # the launch outright: codex app-server rejects any CLI arg (field 2026-08-10, clap usage
  # error before the engine ever spoke).
  [ "$P_EXTRA_OK" = 1 ] || EXTRA_Q=""
  ECMD="$(q "$BIN")${P_ARGV:+ $P_ARGV}$EXTRA_Q"
  { printf 'engine=%s\ncwd=%s\n' "$ENG" "$CWD"
    [ -n "$DELIV" ] && printf 'deliverable=%s\n' "$DELIV"
    [ -n "$MODEL" ] && printf 'model=%s\n' "$MODEL"
    [ -n "$RESUME_THREAD" ] && printf 'resume_thread=%s\n' "$RESUME_THREAD"
    [ -n "$REVIEW" ] && printf 'review=1\n'
    [ -n "$WORKFLOW" ] && printf 'workflow=%s\nmax_rounds=%s\n' "$WORKFLOW" "$MAX_ROUNDS"; } > "$DIR/$S.duplex.meta"

  # exec 3<> holds the fifo read-write so stdin NEVER sees EOF; rc goes out tmp+rename
  PANE="exec 3<>$(q "$FIFO"); $ECMD <&3 >> $(q "$EV") 2>> $(q "$ERR"); e=\$?; echo \$e > $(q "$RC").tmp && mv $(q "$RC").tmp $(q "$RC")"
  if ! tmux new-session -d -s "$S" -c "$CWD" "$PANE"; then
    rm -f "$FIFO" "$DIR/$S.duplex.meta"
    echo "ERR: tmux new-session failed for '$S' (nothing started)" >&2; exit 1
  fi

  # pane pgid for reap-at-stop: pid alone is recyclable, so pair it with the leader's start time
  PANE_PID="$(tmux display-message -p -t "=$S:" '#{pane_pid}' 2>/dev/null)"
  PANE_LSTART="$(ps -p "${PANE_PID:-0}" -o lstart= 2>/dev/null | sed 's/ *$//')"
  [ -n "$PANE_PID" ] && [ -n "$PANE_LSTART" ] \
    && printf 'pane_pid=%s\npane_lstart=%s\n' "$PANE_PID" "$PANE_LSTART" >> "$DIR/$S.duplex.meta"
  # pin remain-on-exit off: inherited "on" outlives a DEAD pane and stop's live #{pane_pid}
  # read would hand reap an exited, recyclable pid (review S1)
  tmux set-option -w -t "=$S:" remain-on-exit off 2>/dev/null || true

  if ! ctl wait-ready "$S" --wait 20; then
    echo "ERR: engine handshake failed — cleaning up. stderr tail:" >&2
    tail -c 800 "$ERR" >&2 2>/dev/null || true
    tmux kill-session -t "=$S" 2>/dev/null; reap_tree "$PANE_PID" ""
    rm -f "$FIFO" "$DIR/$S.duplex.meta"
    exit 1
  fi

  PROMPT="$DIR/$S.duplex.prompt"
  cat "$GOAL" > "$PROMPT"; append_footer "$PROMPT" "$CWD" "$DIR/$S.identity.d/blocked-stamp.txt" "$DELIV"
  ctl send "$S" --verb prompt --file "$PROMPT" || {
    echo "ERR: goal delivery failed — engine up but prompt not accepted; inspect then agentctl stop $S" >&2; exit 2; }
  echo "started $ENG → duplex session '$S' (cwd $CWD; tmux supervises, protocol steers)"
  echo "events : $EV (raw stays on disk; status/watch print bounded summaries only)"
  # What was REQUESTED, and by which route — never what took effect. The request reaches the
  # engine two different ways (argv for the forwarding providers, meta + protocol for the
  # pinned ones), and nothing here reads back the model the engine actually settled on.
  REQ="${MODEL:+model=$MODEL}"
  [ -n "$REVIEW" ] && REQ="${REQ:+$REQ; }review sandbox=$P_REVIEW_SANDBOX"
  if [ "$P_EXTRA_OK" = 1 ] && [ "${#EXTRA[@]}" -gt 0 ]; then REQ="${REQ:+$REQ; }argv ${EXTRA[*]}"; fi
  echo "engine : $ENG — requested: ${REQ:-nothing (engine defaults apply)}; the model/backend actually in effect is the engine's own and is not read back here"
  echo "next   : agentctl watch $S   (blocking, run_in_background)  |  agentctl status $S  (one-shot)"
}

cmd_steer() {
  S="${1:?usage: agentctl steer <session> (-m TEXT | -f FILE) [--now|--replace] [-d G]}"; shift
  MODE=""; ARG=""; VERB="steer"; NEWDELIV=""
  while [ "$#" -gt 0 ]; do case "$1" in
    -m|-f) MODE="$1"; ARG="${2:?$1 needs a value}"; shift 2;;
    --now) VERB="steer-now"; shift;;
    --replace) VERB="replace"; shift;;
    -d|--deliverable) NEWDELIV="${2:?-d needs a glob}"; shift 2;;
    *) echo "ERR: unknown steer option '$1'" >&2; usage;;
  esac; done
  [ -n "$MODE" ] || usage
  case "$(lane_of "$S")" in
    duplex)
      REVIEW_META="$(meta_get "$S" review)"
      [ "$MODE" = -f ] && { [ -e "$ARG" ] || { echo "ERR: file not found: $ARG" >&2; exit 1; }; }
      # `steer -d` moves the freshness target into the SAME line-oriented meta and past the SAME
      # fence, so it clears the same gate `start` did — otherwise a session that opened
      # compliant is walked outside its fence by one steer. Only when `-d` is present:
      # a plain steer writes no new value, so there is nothing to judge.
      if [ -n "$NEWDELIV" ]; then
        ctl check-params --gate "steer -d" --cwd "$(meta_get "$S" cwd)" \
           ${REVIEW_META:+--review} --deliverable "$NEWDELIV" || exit 1
      fi
      # The terminal record is NOT cleared here: a REFUSED steer opens no round and the
      # conclusion it would destroy is still every attached waiter's answer (R2 F-02) — duplexctl
      # unlinks it inside commit_round_state, at the instant the round counter moves. `--replace`
      # mints a NEW attempt, so the supervisor is about to go stale: retire it here.
      [ "$VERB" = replace ] && retire_supervisor "$S" "agentctl steer --replace is opening a new attempt"
      # -d rides duplexctl: applied atomically, only after delivery
      if [ "$MODE" = -f ]; then exec "$PY" "$CTL" --run-dir "$DIR" send "$S" --verb "$VERB" --file "$ARG" ${NEWDELIV:+--deliverable "$NEWDELIV"}
      else exec "$PY" "$CTL" --run-dir "$DIR" send "$S" --verb "$VERB" --text "$ARG" ${NEWDELIV:+--deliverable "$NEWDELIV"}; fi ;;
    none) echo "ERR: unknown session '$S' (no duplex state)" >&2; exit 1 ;;
  esac
}

cmd_status() {
  S="${1:?usage: agentctl status <session>}"
  case "$(lane_of "$S")" in
    duplex) exec "$PY" "$CTL" --run-dir "$DIR" status "$S" ;;
    none)   echo "ERR: unknown session '$S'" >&2; exit 1 ;;
  esac
}

# every watch exit prints twice: `=== … ===` for humans, `EXIT=<n>` for a wrapper that swallows
# the exit code and can still parse the verdict off the last line.
watch_exit() { # $1 rc
  echo "EXIT=$1"; exit "$1"
}

# ── supervised watch ──────────────────────────────────────────────────────────────────
# The host reaps orchestrator-side background tasks (field 2026-08-08: ≥6 kills in 40min), so
# the sensing loop lives in tmux — the one place here the reaper does not reach — and
# `agentctl watch` is a DUMB WAITER over the fenced record: killing it costs a re-run, never a
# conclusion (`--inline` keeps the pre-supervised loop). What is left HERE is the tmux half:
# claiming the singleton session name (server-side, atomic) and killing a pane plus its group.
supervisor_of() { printf '%s-watchd\n' "$1"; }   # its OWN tmux session, never a worker window

# Every knob is spelled into the pane command: the loop cannot silently run with other bounds.
supervisor_env() {
  local out="AGENT_WATCH_DIR=$(q "$DIR") " k v
  for k in PATH AGENTCTL_PYTHON AGENT_WATCH_POLL_SECS AGENT_WATCH_MAX_POLLS \
           AGENT_WATCH_SILENT_POLLS AGENT_WATCH_STATUS_TIMEOUT AGENT_WATCH_STALL_MINS \
           AGENTCTL_REAP_GRACE AGENTCTL_PUBLISH_BARRIER TMPDIR; do
    eval "v=\${$k:-}"
    [ -n "$v" ] && out="$out$k=$(q "$v") "
  done
  printf '%s' "$out"
}

# Retirement is identity lifecycle, not housekeeping: a supervisor that outlived its attempt
# would sense a round it cannot speak for. Pane here; last words then lease in the verb.
retire_supervisor() { # $1 session  [$2 why — left as the supervisor's last words for a waiter]
  local sup pane
  sup="$(supervisor_of "$1")"
  if tmux has-session -t "=$sup" 2>/dev/null; then
    pane="$(tmux display-message -p -t "=$sup:" '#{pane_pid}' 2>/dev/null)"
    tmux kill-session -t "=$sup" 2>/dev/null
    reap_tree "$pane" "" >/dev/null 2>&1
  fi
  if [ -n "${2:-}" ]; then ctl supervisor-retire "$1" --why "$2"
  else ctl supervisor-retire "$1"; fi
  return 0
}

# rc 0 = sensing under THIS identity; 1 = structurally impossible (degrade to --inline, loudly);
# 2 = undecidable, NOT a licence to sense inline. STDOUT is the diagnosis.
ensure_supervisor() { # $1 session
  local sup cmd cwd rc mine
  sup="$(supervisor_of "$1")"
  ctl watch-arm-check "$1" --armed-seq "$ARMED_SEQ"; rc=$?
  case "$rc" in
    0|1|2) return "$rc" ;;
    4) retire_supervisor "$1" ;;
  esac
  cwd="$(meta_get "$1" cwd)"; [ -d "$cwd" ] || cwd="$DIR"
  cmd="$(supervisor_env)exec bash $(q "$SELFABS") watch-daemon $(q "$1") >> $(q "$DIR/$1.watch.super.log") 2>&1"
  # tmux session-name uniqueness IS the singleton claim: WHO WON THE NAME is the only honest
  # answer to "whose supervisor is this?" — a later has-session poll cannot tell.
  mine=1
  if ! tmux new-session -d -s "$sup" -c "$cwd" "$cmd" 2>/dev/null; then
    # Losing the race is not an error — but the winner is NOT ours, so it must prove it leases.
    mine=0
    tmux has-session -t "=$sup" 2>/dev/null || {
      echo "tmux refused to create session '$sup' and no session by that name exists"; return 1; }
  fi
  ctl watch-arm-wait "$1" --mine "$mine"; rc=$?
  # 4 = our own pane never leased: retire it (a leaseless pane reads as a rogue), then degrade
  [ "$rc" = 4 ] && { retire_supervisor "$1"; return 1; }
  return "$rc"
}

# External kills are non-deterministic and the sender is invisible from inside the sandbox:
# leave an attributable tombstone, clean the pid file. The child goes FIRST — a survivor could
# still deliver a conclusion for a waiter that is gone.
on_sig() { # $1 signal-name  $2 exit-code
  [ -n "${CHILD:-}" ] && kill "$CHILD" 2>/dev/null
  ctl watch-tombstone "$S" --signal "$1" --ppid "$PPID" --uptime "$SECONDS"
  rm -f "$WPID"; exit "$2"
}

# `wait` on a backgrounded child: a foreground command defers a trapped TERM until it finishes
# (probed: 14s) and the tombstone would lose its TERM→KILL grace window.
run_child() { # $@ — duplexctl subcommand + args; rc = the child process's
  ctl "$@" & CHILD=$!
  wait "$CHILD"
}
sense_inline() { # $1 session — the in-process fallback loop (no supervisor, not kill-resilient)
  run_child sense-loop "$1" --mode inline --armed "$ARMED_ID"
}

cmd_watch() {
  S=""; MODE=supervised
  while [ "$#" -gt 0 ]; do case "$1" in
    --inline) MODE=inline; shift;;
    -*) echo "ERR: unknown watch option '$1'" >&2; usage;;
    *) [ -n "$S" ] && { echo "ERR: watch takes exactly one session" >&2; usage; }; S="$1"; shift;;
  esac; done
  [ -n "$S" ] || usage
  [ "$(lane_of "$S")" = duplex ] || { echo "ERR: unknown session '$S'" >&2; exit 1; }
  WPID="$DIR/$S.duplex.watch.pid"
  trap 'rm -f "$WPID"' EXIT
  trap 'on_sig TERM 143' TERM; trap 'on_sig INT 130' INT
  # Poll cadence, the poll budget and the ENGINE-SILENT bound are AGENT_WATCH_* env knobs read
  # by the loop verbs themselves — the shell forwards the environment, not a copy of the defaults.
  # The two arm-time snapshots every later decision is fenced by, captured ONCE and passed down:
  # the identity this watcher may publish under, and the delivery watermark for its episode.
  # Opaque here — the shell forwards them, it never compares them.
  ARMED_ID="$(ctl identity token "$S" 2>/dev/null)"
  ARMED_SEQ="$(ctl identity watermark "$S" 2>/dev/null)"
  [ -n "${ARMED_SEQ:-}" ] || ARMED_SEQ=0
  ctl watch-arm "$S" --pid $$
  [ "$MODE" = inline ] && { sense_inline "$S"; exit $?; }
  # arm-time read: a conclusion on disk IS this invocation's answer. 13 = keep going; anything
  # else is the verdict, already printed, and is forwarded untouched.
  run_child watch-arm-read "$S" --armed-seq "$ARMED_SEQ"; rc=$?
  [ "$rc" = 13 ] || exit "$rc"
  sup_why="$(ensure_supervisor "$S")"; sup_rc=$?
  if [ "$sup_rc" = 2 ]; then
    # undecidable, NOT a licence to sense inline: the four-state machine's ④.
    echo "=== [$S] SUPERVISOR-LOST: reason=unknown $sup_why ==="
    watch_exit 12
  fi
  if [ "$sup_rc" != 0 ]; then
    echo "NOTE: the tmux watch supervisor for '$S' is structurally impossible here — $sup_why. Falling back to the in-process --inline sensing loop: this watch is NOT kill-resilient (an external TERM loses this round's conclusion) and persists no non-DONE class." >&2
    sense_inline "$S"; exit $?
  fi
  echo "[$S] supervised: sensing runs in tmux session $(supervisor_of "$S") (log $DIR/$S.watch.super.log); this waiter only reads the fenced terminal record"
  run_child watch-wait "$S" --armed-seq "$ARMED_SEQ"
  exit $?
}

cmd_watch_daemon() { # INTERNAL — the sensing loop, launched by ensure_supervisor inside tmux
  S="${1:?usage: agentctl watch-daemon <session>}"
  [ "$(lane_of "$S")" = duplex ] || { echo "ERR: unknown session '$S'" >&2; exit 1; }
  ARMED_ID="$(ctl identity token "$S" 2>/dev/null)"
  # exec: the loop IS the pane process, so kill-session reaches it and its own handlers (which
  # leave the last words) are the prompt ones
  exec "$PY" "$CTL" --run-dir "$DIR" sense-loop "$S" --mode daemon --armed "$ARMED_ID"
}

cmd_stop() {
  S="${1:?usage: agentctl stop <session>}"
  case "$(lane_of "$S")" in
    duplex)
      # Read the reap identity BEFORE the kill: the live pane pid is only trustworthy while the
      # pane is ALIVE (review S1); a dead pane falls back to the meta pid+lstart fingerprint. The
      # supervisor goes down FIRST — it must not publish for a session being torn down.
      retire_supervisor "$S"
      live="$(tmux display-message -p -t "=$S:" '#{pane_dead} #{pane_pid}' 2>/dev/null)"
      live_pg=""; case "$live" in "0 "*) live_pg="${live#0 }";; esac
      meta_pg="$(meta_get "$S" pane_pid)"; meta_ls="$(meta_get "$S" pane_lstart)"
      # snapshot BEFORE the kill: after it, the pane is gone and its escapees unattributable
      survivor_probe "$S" "${live_pg:-$meta_pg}"
      tmux kill-session -t "=$S" 2>/dev/null && echo "killed tmux session $S" || echo "no tmux session $S"
      # Cleanup precedes the reap: the marker guard prices in a µs kill→cleanup gap, a grace-long
      # reap would stretch it to seconds (S3). The sentinel brackets the reap from INSIDE these two
      # verbs — no timestamp in this shell, only an opaque token fencing part 2 to part 1's sample.
      STOP_TOK="$$-$RANDOM"; ctl stop-cleanup "$S" --token "$STOP_TOK"; ID_RC=$?
      if [ -n "$live_pg" ]; then reap_tree "$live_pg" ""
      else reap_tree "$meta_pg" "$meta_ls"; fi
      REAP_RC=$?
      survivor_advise "$S"
      ctl stop-sentinel "$S" --token "$STOP_TOK"
      # a refused identity clear fails stop's contract: the name is not free to reuse
      [ "$ID_RC" = 0 ] || exit 1
      exit "$REAP_RC" ;;
    none)
      # no lane meta: clean bare tmux AND orphan duplex claims — the recovery path start advertises
      cleaned=0; reap_rc=0
      retire_supervisor "$S"
      if tmux has-session -t "=$S" 2>/dev/null; then
        live="$(tmux display-message -p -t "=$S:" '#{pane_dead} #{pane_pid}' 2>/dev/null)"
        live_pg=""; case "$live" in "0 "*) live_pg="${live#0 }";; esac
        survivor_probe "$S" "$live_pg"
        tmux kill-session -t "=$S" 2>/dev/null; reap_tree "$live_pg" "" || reap_rc=1
        survivor_advise "$S"
        echo "killed bare tmux session $S"; cleaned=1
      fi
      ctl stop-residue "$S" --killed "$cleaned" --reap-rc "$reap_rc"; exit $? ;;
  esac
}

case "${1:-}" in
  start)  shift; cmd_start "$@" ;;
  watch-daemon) shift; cmd_watch_daemon "$@" ;;
  steer)  shift; cmd_steer "$@" ;;
  status) shift; cmd_status "$@" ;;
  watch)  shift; cmd_watch "$@" ;;
  capabilities) shift; case "${1:-}" in
            "") "$PY" "$CTL" capabilities ;;
            --json) "$PY" "$CTL" capabilities --json ;;
            *) echo "ERR: unknown capabilities option '$1' (only --json)" >&2; exit 1 ;;
          esac ;;
  # exactly two spellings; anything else (including an extra word after --json) is refused
  states) shift; case "$#:${1:-}" in
            "0:")       "$PY" "$CTL" states ;;
            "1:--json") "$PY" "$CTL" states --json ;;
            *) echo "ERR: states is read-only and is spelled 'agentctl states' or 'agentctl states --json' — got: $*" >&2; exit 1 ;;
          esac ;;
  # read-only by construction: the argument contract is refused HERE, before any probe runs
  inventory) shift; case "${1:-}" in
            --dry-run) [ "$#" -eq 1 ] || { echo "ERR: inventory takes nothing beyond --dry-run (got: ${*:2})" >&2; exit 1; }
                       exec "$PY" "$CTL" --run-dir "$DIR" inventory --dry-run ;;
            *) echo "ERR: inventory is read-only and is spelled 'agentctl inventory --dry-run'${1:+ — got '$1'}; there is no --apply" >&2; exit 1 ;;
          esac ;;
  stop)   shift; cmd_stop "$@" ;;
  ""|-h|--help) usage ;;
  *) echo "ERR: unknown subcommand '${1}'" >&2; usage ;;
esac
